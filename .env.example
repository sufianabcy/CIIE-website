# Copy to .env for local runs. On a host, set these as environment variables instead.
# Never commit a real .env: passwords and keys live only in the host's settings
# and the club's password manager.

# --- Basics -----------------------------------------------------------------
DEBUG=1                                   # 0 on a real server
SECRET_KEY=change-me                      # long random string on a real server
DATABASE_URL=postgres://ciie:ciie@localhost:5432/ciie
ALLOWED_HOSTS=localhost,127.0.0.1         # e.g. events.klciie.in (Render's own address is added automatically)
CSRF_TRUSTED_ORIGINS=                     # e.g. https://events.klciie.in
SITE_URL=http://localhost:8000            # used in emails; e.g. https://events.klciie.in
SECURE_COOKIES=0                          # 1 on a real server (HTTPS)
SECURE_SSL_REDIRECT=0                     # 1 on a real server
SECURE_HSTS_SECONDS=0                     # 3600, then 31536000 once HTTPS is proven

FIRST_ADMIN_EMAIL=                        # made admin on first start if there is no admin yet

# --- Club -------------------------------------------------------------------
CLUB_NAME=KL-CIIE
CLUB_CONTACT_EMAIL=klciie@kluniversity.in
KL_EMAIL_DOMAINS=kluniversity.in          # comma-separated; codes sent here prove KL status
KL_STUDENT_ID_PATTERN=^\d{8,12}$          # how a KL ID looks (to verify with KL)
KL_STUDENT_EMAIL_FORMAT={id}@kluniversity.in

# --- Email ------------------------------------------------------------------
# Local: print emails (and sign-in codes) in the terminal.
EMAIL_URL=consolemail://
# Free hosting blocks SMTP, so use a sending service's HTTPS API through django-anymail:
# ANYMAIL_ESP=brevo                       # or resend, postmark, amazon_ses ...
# ANYMAIL_API_KEY=xkeysib-...
# A paid host can use SMTP instead, e.g. the club Gmail with an app password:
# EMAIL_URL=smtp+tls://klciie.events@gmail.com:app-password@smtp.gmail.com:587
DEFAULT_FROM_EMAIL=KL-CIIE <noreply@localhost>
MAIL_SEND_INLINE=1                        # send right after each page saves the email (no worker needed)
MAIL_DAILY_CAP=280                        # stay under the provider's daily limit (Brevo free: 300)
MAIL_CODE_RESERVE=80                      # always kept for sign-in codes
MAIL_RATE_PER_MINUTE=20
OPS_TICK_TOKEN=                           # secret for /ops/tick/, which a free scheduler calls to retry mail

# --- Sign-in with Google or Microsoft (optional) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
KL_MICROSOFT_TENANT_ID=                   # only KL's own tenant counts as KL

# --- Backups ----------------------------------------------------------------
BACKUP_AGE_RECIPIENT=                     # age public key (age1...); the private key stays offline
BACKUP_RCLONE_REMOTES=                    # e.g. gdrive:klciie-backups,onedrive:klciie-backups
BACKUP_INTERVAL_MINUTES=60                # only used when the worker runs backups

# --- Processes --------------------------------------------------------------
WEB_CONCURRENCY=2
RUN_WORKER_IN_WEB=0                       # 1 runs the worker beside the web process
LOG_LEVEL=INFO
